# ─── Server ──────────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=production

# ─── Frontend Vite (dev only) ─────────────────────────────────────────────────
# Leave blank or set to "/" for standalone deployments
BASE_PATH=/

# ─── Database ─────────────────────────────────────────────────────────────────
# PostgreSQL connection string
DATABASE_URL=postgresql://user:password@localhost:5432/creative_agency

# ─── Optional ─────────────────────────────────────────────────────────────────
# SESSION_SECRET=change_me_to_a_long_random_string
