# ─── Server ──────────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=production

# ─── Frontend Vite (dev only) ─────────────────────────────────────────────────
# Leave blank or set to "/" for standalone deployments
BASE_PATH=/

# ─── Database ─────────────────────────────────────────────────────────────────
# PostgreSQL connection string. For docker-compose this is built automatically
# from PGUSER / PGPASSWORD / PGDATABASE below — you only need to set
# DATABASE_URL when running the API server outside of docker-compose.
DATABASE_URL=postgresql://user:password@localhost:5432/tsa_site

# ─── docker-compose ───────────────────────────────────────────────────────────
# Used by docker-compose.yml to provision the bundled Postgres container and
# build DATABASE_URL for the app container. Pick strong values in production.
PGUSER=postgres
PGPASSWORD=change_me_to_a_strong_db_password
PGDATABASE=tsa_site
# Host port that the app container listens on (defaults to 3001).
APP_PORT=3001

# ─── Reverse proxy / TLS (optional) ───────────────────────────────────────────
# Set ONLY when the app sits behind a trusted reverse proxy such as nginx,
# Caddy, or Cloudflare. With this set, the app trusts X-Forwarded-* headers,
# which the proxy uses to convey the client IP and the original protocol
# (https). Leave this UNSET for direct-HTTP deployments — otherwise clients
# could spoof X-Forwarded-For and bypass the login rate limiter.
# TRUST_PROXY=1
#
# Force the admin-session cookie to be HTTPS-only. By default the app sets
# the Secure flag automatically when the request arrived over HTTPS. Override
# only if you know what you're doing.
# COOKIE_SECURE=true

# ─── Admin CMS ────────────────────────────────────────────────────────────────
# Single-admin password used to sign in at /admin/login
ADMIN_PASSWORD=change_me_to_a_strong_password

# HMAC secret used to sign the admin session JWT cookie. Must be at least 16
# characters; use a long random string in production.
SESSION_SECRET=change_me_to_a_long_random_string
